{
  "manifest_version": 3,
  "name": "N",
  "description": "Minimalist and simple full-tab notepad for distraction-free writing.",
  "version": "1.4",
  "permissions": ["storage"],
  "action": {
    "default_title": "Open N",
    "default_icon": "icon.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "128": "icon.png"
  }
}